# All three are optional — each unlocks live search for its category.
# Leave any of them blank and that category just falls back to manual
# entry, same as before.

# Free key, no payment required: https://rawg.io/apidocs
RAWG_API_KEY=

# Free key, no payment required: https://comicvine.gamespot.com/api/
COMICVINE_API_KEY=

# Free key, no payment required: https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional — change the port the proxy listens on
PORT=3001
